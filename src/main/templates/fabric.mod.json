{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {},
  "license": "${mod_license}",
  "icon": "assets/pondus/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dinner.dev.pondus.PondusFabric"
    ],
    "client": [
      "dinner.dev.pondus.PondusClientFabric"
    ]
  },
  "mixins": [
    "pondus.mixins.json",
    "pondus.fabric.mixins.json"
  ],
  "accessWidener": "pondus.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=1.21.1 <=1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "cloth-config": ">=${cloth_config_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/fabric"
      }
    }
  }
}
